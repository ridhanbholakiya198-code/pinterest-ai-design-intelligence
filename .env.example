# Pinterest AI Design Intelligence
# Environment Configuration

# ------------------------------------------------------------------------------
# PINTEREST API OAUTH
# ------------------------------------------------------------------------------
# Get these from the Pinterest Developer Portal
PINTEREST_CLIENT_ID="YOUR_PINTEREST_CLIENT_ID"
PINTEREST_CLIENT_SECRET="YOUR_PINTEREST_CLIENT_SECRET"
PINTEREST_REDIRECT_URI="YOUR_PINTEREST_REDIRECT_URI" # Usually: APP_URL + /api/auth/pinterest/callback

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# APP AND SESSION
# ------------------------------------------------------------------------------
# The URL where this applet is hosted (provided by AI Studio)
APP_URL="http://localhost:3000"
# Secret used for encrypting session cookies
SESSION_SECRET="YOUR_RANDOM_SESSION_SECRET_KEY"
